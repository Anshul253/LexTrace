# LexTrace needs no API keys: no hosted LLM is used.
# Optional: read the raw dataset from another directory (default: data/raw)
# LEXTRACE_DATA_DIR=D:/datasets/legalbench-rag
# Optional: Hugging Face mirror / cache location for dataset and embedding-model downloads
# HF_ENDPOINT=https://huggingface.co
# HF_HOME=D:/hf-cache
